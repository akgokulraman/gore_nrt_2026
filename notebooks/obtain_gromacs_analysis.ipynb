    "                mpirun gmx rdf -f {xtc_file} -s {tpr_file} -n {config}/custom.ndx -ref Tolue -sel Tail Head_1_2  Head_3_4 Poly_MB Poly_ME Poly_MT Poly_E1 Poly_E2 W -o {config}/rdf_analysis/rdf_ref_Tolue.xvg -bin 0.05 -dt 25000\n",
